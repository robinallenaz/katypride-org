{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Community events displayed on the /events page. Includes Espresso Yourself meetups and special events like Chase the Rainbow 5K."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "start": {
      "type": "datetime",
      "required": true
    },
    "end": {
      "type": "datetime"
    },
    "location": {
      "type": "string"
    },
    "summary": {
      "type": "blocks"
    },
    "externalUrl": {
      "type": "string"
    },
    "externalCtaLabel": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "eventCategory": {
      "type": "enumeration",
      "default": "general",
      "enum": [
        "general",
        "coffee",
        "social",
        "fundraising",
        "advocacy",
        "education",
        "health",
        "youth",
        "pride",
        "volunteer",
        "cultural",
        "community"
      ]
    },
    "isRecurring": {
      "type": "boolean",
      "default": false
    },
    "recurrencePattern": {
      "type": "enumeration",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "yearly"
      ]
    },
    "recurrenceInterval": {
      "type": "integer",
      "default": 1,
      "min": 1
    },
    "recurrenceEndDate": {
      "type": "datetime"
    },
    "recurrenceDaysOfWeek": {
      "type": "json",
      "default": []
    },
    "recurrenceExceptions": {
      "type": "text"
    }
  }
}
