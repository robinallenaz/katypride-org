{
  "kind": "collectionType",
  "collectionName": "resource_links",
  "info": {
    "singularName": "resource-link",
    "pluralName": "resource-links",
    "displayName": "Resource Link",
    "description": "LGBTQ+ resources shown on the /resources page. Categorized by health, advocacy, ally, regional, and national."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "health",
        "advocacy",
        "ally",
        "regional",
        "national"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "text"
    }
  }
}
